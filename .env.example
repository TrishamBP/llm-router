# Copy to .env and fill in locally. Never commit real credentials.

# --- Model provider credentials ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Fireworks.ai embeddings (complexity classifier) ---
# 1. Create an API key in the Fireworks dashboard. Paste it ONLY into your local .env
#    (git-ignored), never into source code, configs, issues, or chat.
# 2. Choose an embeddings model from Fireworks' model library and copy its exact model ID.
#    The pipeline does not pick a default; it verifies the model with a one-request
#    connectivity test (`python -m llm_router.embeddings.fireworks_client --test`).
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_EMBEDDING_MODEL=

# --- Candidate models ---
# Model versions and provider IDs live in the registry file, not in environment variables.
ROUTER_MODEL_REGISTRY=configs/model_registry.yaml

# --- Experiment configuration ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=llm-router
ROUTER_RANDOM_SEED=42
ROUTER_DEVICE=cpu
ROUTER_ARTIFACTS_DIR=./artifacts
ROUTER_LOG_LEVEL=INFO
